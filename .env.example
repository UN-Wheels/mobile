# Copia este archivo como .env y ajusta los valores a tu entorno.

# Emulador Android: usa 10.0.2.2 para acceder al localhost del host
# Teléfono físico USB: ejecuta "adb reverse tcp:8080 tcp:8080" y usa 127.0.0.1
# Teléfono físico WiFi: usa la IP local de tu PC en la red (ej: 192.168.1.X)
API_BASE_URL=http://127.0.0.1:8080/api

# URL del Chat Service (Socket.IO) — mismo esquema que API_BASE_URL
# Ejecuta también "adb reverse tcp:3001 tcp:3001" para teléfono físico USB
CHAT_SOCKET_URL=http://127.0.0.1:3001
